https://:preview.prds.workers.dev/*
  X-Robots-Tag: noindex

/
  Cache-Control: public, no-cache, no-transform

/index.html
  Cache-Control: public, no-cache, no-transform

# Every top-level page; its .html form too. Also matches root files such as favicon.ico.
/:page
  Cache-Control: public, no-cache, no-transform

# Subpages such as /Admag/Berserkers and /Update/0.20.
/:parent/:page
  Cache-Control: public, no-cache, no-transform

/:grandparent/:parent/:page
  Cache-Control: public, no-cache, no-transform

/pagefind/*
  Cache-Control: public, no-cache, no-transform
