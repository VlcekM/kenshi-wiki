---
import WikiLayout from '../layouts/WikiLayout.astro';
---

<WikiLayout title="Search" description="Search the pages of Kenshi Wiki." source="src/pages/Search.astro" searchable={false}>
  <form action="/Search" class="search-page-form" role="search">
    <input type="search" name="q" id="searchText" aria-label="Search Kenshi Wiki" autofocus />
    <input type="hidden" name="fulltext" value="1" />
    <button type="submit">Search</button>
  </form>
  <p class="search-status" aria-live="polite"></p>
  <ul class="mw-search-results"></ul>
</WikiLayout>

<script>
  interface Result {
    url: string;
    excerpt: string;
    meta: { title?: string };
  }

  const params = new URLSearchParams(location.search);
  const query = (params.get('q') ?? '').trim();
  const status = document.querySelector<HTMLElement>('.search-status')!;
  const list = document.querySelector<HTMLUListElement>('.mw-search-results')!;
  document.querySelector<HTMLInputElement>('#searchText')!.value = query;

  // Pagefind lists /About_Kenshi.html; the wiki serves it at /About_Kenshi.
  const pagePath = (url: string) => url.replace(/\.html$/, '');
  const sameTitle = (a: string, b: string) => a.replaceAll('_', ' ').toLowerCase() === b.replaceAll('_', ' ').toLowerCase();

  async function findPages(text: string): Promise<Result[]> {
    const indexUrl = '/pagefind/pagefind.js';
    const pagefind = await import(/* @vite-ignore */ indexUrl);
    const search = await pagefind.search(text);
    return Promise.all(search.results.slice(0, 20).map((result: { data: () => Promise<Result> }) => result.data()));
  }

  function showResult(result: Result) {
    const item = document.createElement('li');
    const heading = document.createElement('div');
    const link = document.createElement('a');
    const excerpt = document.createElement('div');

    heading.className = 'mw-search-result-heading';
    link.href = pagePath(result.url);
    link.textContent = result.meta.title ?? pagePath(result.url).slice(1).replaceAll('_', ' ');
    excerpt.className = 'searchresult';
    // Pagefind escapes the page text and wraps the matched words in <mark>.
    excerpt.innerHTML = result.excerpt;

    heading.append(link);
    item.append(heading, excerpt);
    list.append(item);
  }

  async function run() {
    if (!query) {
      status.textContent = 'Enter a word or page name to search for.';
      return;
    }

    let results: Result[];
    try {
      results = await findPages(query);
    } catch {
      status.textContent = 'The search index is missing. It is generated by npm run build, so search does not work under npm run dev.';
      return;
    }

    // As on MediaWiki, the Go button opens a page whose title matches exactly.
    const page = !params.has('fulltext') && results.find(result => sameTitle(result.meta.title ?? '', query));
    if (page) {
      location.replace(pagePath(page.url));
      return;
    }

    status.textContent = results.length ? `Pages matching “${query}”:` : `There were no results matching “${query}”.`;
    results.forEach(showResult);
  }

  run();
</script>

<style is:global>
  /* Global, because the result list is built by the script and carries no scoped-style attributes. */
  .page-Search #firstHeading { display: block; }
  .search-page-form { display: flex; gap: 0.5em; margin-bottom: 1em; max-width: 40em; }
  .search-page-form input,
  .search-page-form button {
    font: inherit;
    padding: 0.3em 0.5em;
    color: var(--paper-12);
    background-color: var(--paper-00);
    border: 1px solid var(--paper-08);
    border-radius: 2px;
  }
  .search-page-form input { flex: 1; }
  .search-page-form input:focus { outline: 0; border-color: var(--link); box-shadow: inset 0 0 0 1px var(--link); }
  .search-page-form button { cursor: pointer; background-color: var(--paper-02); }
  .mw-parser-output .mw-search-results { list-style: none; margin: 0; max-width: 76ch; }
  .mw-search-results li { margin-bottom: 1em; }
  .mw-search-result-heading { font-size: 1.1em; }
  .searchresult mark { background: none; color: inherit; font-weight: bold; }
</style>
