---
import WikiLayout from '../layouts/WikiLayout.astro';
import { repoUrl, wiki } from '../lib/wiki.js';

const sections = [
  {
    title: 'Concepts',
    cards: [
      { title: 'Basics', icon: '📖', links: ['Controls', 'User interface', "Beginner's guide", 'Lore', 'Guides', 'Glossary'] },
      { title: 'Gameplay', icon: '🎒', links: ['Skills', 'Research', 'Trade', 'Bounties', 'Stealth', 'Crafting'] },
      { title: 'Extras', icon: '🛠️', links: ['Version history', 'Save files', 'Forgotten Construction Set', 'Mods', 'Modding tutorials'] },
      { title: 'Combat', icon: '⚔️', links: ['Melee', 'Martial arts', 'Ranged', 'Injuries', 'Tactics'] },
      { title: 'World', icon: '🌍', links: ['Map', 'Zones', 'Towns', 'Factions', 'Weather'] },
    ],
  },
  {
    title: 'Items',
    cards: [
      { title: 'Gear', icon: '🗡️', links: ['Weapons', 'Armour', 'Clothing', 'Backpacks', 'Robotic limbs'] },
      { title: 'Resources', icon: '📦', links: ['Materials', 'Food', 'Drugs', 'Medicine', 'Artifacts'] },
      { title: 'Technology', icon: '⚙️', links: ['Blueprints', 'Books', 'AI cores', 'Engineering', 'Robotics'] },
      {
        title: 'Building',
        icon: '🏚️',
        links: ['Outposts', 'Production', 'Power', 'Farming', 'Storage', 'Defences', 'Furniture', 'Walls and gates', 'Crafting stations', 'Prisoners'],
      },
    ],
  },
  {
    title: 'Life',
    cards: [
      { title: 'Characters', icon: '🧍', links: ['Recruits', 'Unique NPCs', 'Health', 'Hunger', 'Stats', 'Traits'] },
      { title: 'Races', icon: '🧬', links: ['Greenlander', 'Scorchlander', 'Shek', 'Hive', 'Skeleton'] },
      { title: 'Fauna', icon: '🦎', links: ['Animals', 'Pets', 'Pack animals', 'Wildlife'] },
      { title: 'Flora', icon: '🌵', links: ['Crops', 'Wild plants', 'Biomes'] },
    ],
  },
];

// Cards list their links in two columns once there are more than five.
const columns = (links) => (links.length > 5 ? [links.slice(0, Math.ceil(links.length / 2)), links.slice(Math.ceil(links.length / 2))] : [links]);
---

<WikiLayout
  title="Main Page"
  description="The community wiki for Kenshi, the open-world squad-based RPG by Lo-Fi Games."
  source="src/pages/index.astro"
  categories={['Kenshi Wiki']}
  mainPage
>
  <div class="mainpage-intro">
    <center>
      <a href="/"><img class="mainpage-wordmark" src="/kenshi-wordmark.png" alt="Kenshi" width="400" height="187" /></a>
    </center>
    <center>
      <big>
        <b><a href={wiki('Kenshi')}>Kenshi</a></b> is an open-world, squad-based RPG developed by{' '}
        <b><a href={wiki('Lo-Fi Games')}>Lo-Fi&nbsp;Games</a></b>, an independent studio founded by{' '}
        <b><a href={wiki('Chris Hunt')}>Chris&nbsp;Hunt</a></b>.
        <br />
        Read more about the game at <a href={wiki('About Kenshi')}>About Kenshi</a>.
      </big>
    </center>

    <div class="mainpage-about">
      <div class="mainpage-about-text">
        <p>
          <br />
          A complete history of releases can be found on the <a href={wiki('Version history')}>Version history</a> page.
        </p>
        <p>
          <br />
          This wiki is written by the community. Every page is a file in our <a href={repoUrl}>GitHub repository</a>, and
          changes are made as pull requests. It is recommended to read the <a href={`${repoUrl}#contributing`}>contribution guide</a>{' '}
          and our <a href={wiki('Style guide')}>Style guide</a>.
        </p>
      </div>
      <div class="mainpage-about-links">
        <dl>
          <dd>&#9642;&nbsp;<a class="external" href="https://store.steampowered.com/app/233860/Kenshi/">Steam Page</a></dd>
          <dd>&#9642;&nbsp;<a class="external" href="https://lofigames.com/">Lo-Fi Games</a></dd>
        </dl>
        <dl>
          <dd>&#9642;&nbsp;<a class="external" href="https://www.reddit.com/r/Kenshi/">Kenshi on Reddit</a></dd>
          <dd>&#9642;&nbsp;<a class="external" href="https://steamcommunity.com/app/233860/workshop/">Steam Workshop</a></dd>
        </dl>
      </div>
    </div>
  </div>

  <center>
    <h3><b>Need some help? Check out the <a href={wiki('Guides')}>guides</a> for information!</b></h3>
  </center>

  <div class="mainpage-sections">
    {sections.map((section) => (
      <div class="mainpage-section">
        <h2><span class="mw-headline" id={section.title}>{section.title}</span></h2>
        <div class="mainpage-boxes">
          {section.cards.map((card) => (
            <div class="mainpage-box-wrap">
            <div class="mainpage-box">
              <div class="mainpage-box-side">
                <div class="mainpage-box-title">
                  <center><b><a href={wiki(card.title)}>{card.title}</a></b></center>
                </div>
                <div class="mainpage-box-icon">
                  <center><span aria-hidden="true">{card.icon}</span></center>
                </div>
              </div>
              {columns(card.links).map((column) => (
                <div class="mainpage-box-links">
                  <p>
                    {column.map((link) => (
                      <Fragment>&#9642; <a href={wiki(link)}>{link}</a><br /></Fragment>
                    ))}
                  </p>
                </div>
              ))}
            </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</WikiLayout>
