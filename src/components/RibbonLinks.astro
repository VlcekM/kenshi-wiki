---
interface Props {
  links: { label: string; href: string; image?: string; glyph?: string }[];
}
const { links } = Astro.props;
---
{links.map(({ label, href, image, glyph }) => (
  <a class="ribbon-link" href={href}>
    {image && <img src={`/ribbon-icons/${image}.webp`} alt="" width="16" height="16" />}
    {glyph && <span class="ribbon-glyph" aria-hidden="true" style={`--glyph: url('/ribbon-icons/${glyph}.svg')`} />}
    <span>{label}</span>
  </a>
))}
